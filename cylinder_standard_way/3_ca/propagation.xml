<?xml version="1.0" encoding="UTF-8"?>
<cfsSimulation xmlns="http://www.cfs++.org/simulation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.cfs++.org/simulation https://opencfs.gitlab.io/cfs/xml/CFS-Simulation/CFS.xsd">
	<documentation>
		<title>Sound propagation simulation</title>
		<authors>
			<author>Andreas Wurzinger</author>
		</authors>
		<date>2022-10-08</date>
		<keywords>
			<keyword>aeroacoustics</keyword>
			<keyword>nonmatching grids</keyword>
			<keyword>pml</keyword>
			<keyword>transient</keyword>
		</keywords>
		<references></references>
		<isVerified>yes</isVerified>
		<description> Propagation simulation solving the aeroacoustic wave equation for the acoustic
			scalar potential </description>
	</documentation>
	<fileFormats>
		<!-- Data Input -->
		<input>
			<hdf5
				fileName="../2_interpolation/results_hdf5/source_acouRhsLoad.cfs" />
			<hdf5
				fileName="../0_mesh/PML.cfs"
				id="id2" />
			<hdf5
				fileName="../0_mesh/propagationRegion.cfs"
				id="id3" />
		</input>
		<!-- Data Output -->
		<output>
			<hdf5 />
			<text id="txt" />
		</output>
		<!-- Material File -->
		<!-- eg.: <materialData file="..." format="..."/> -->
		<materialData file="air.xml" format="xml" />
	</fileFormats>

	<domain geometryType="plane">
		<!-- User-defined Variables -->
		<variableList>
			<!-- Material parameters for source term scaling -->
			<var name="rho" value="1.204" />
			<var name="c" value="343.5" />
			<!-- Parameter for spatial blending function -->
			<var name="sigma" value="0.6" />
			<!-- Parameter for temporal blending function -->
			<var name="tau" value="20e-3" />
		</variableList>
		<!-- Volume Regions -->
		<regionList>
			<region name="internal" material="air_20deg" />
			<region name="prop" material="air_20deg" />
			<region name="pml" material="air_20deg" />
			<!-- eg.: <region name="RegionName" material="MaterialName"/> -->
		</regionList>
		<!-- Surface Regions -->
		<surfRegionList>
			<!-- <surfRegion name="..."/> -->
			<!--eg.:
			<surfRegion name="bc"/> -->
			<surfRegion name="BC_IFin" />
			<surfRegion name="BC_IFout" />
			<surfRegion name="bc" />
			<surfRegion name="ifborder" />
		</surfRegionList>
		<!-- Non-conforming Interfaces -->
		<ncInterfaceList>
			<!-- <ncInterface name="..." masterSide="..." slaveSide="..." /> -->
			<!--eg.:
			<ncInterface name="NC1" masterSide="bc" slaveSide="BC_IFin" /> -->
			<ncInterface name="NC1" primarySide="bc" secondarySide="BC_IFin" />
			<ncInterface name="NC2" primarySide="BC_IFout" secondarySide="ifborder" />
		</ncInterfaceList>
		<!-- User-defined Points -->
		<elemList>
			<elems name="mic1e">
				<coord x="1" y="0" />
			</elems>
			<elems name="mic2e">
				<coord x="0" y="4" />
			</elems>

		</elemList>
		<nodeList>
			<nodes name="mic1n">
				<coord x="1" y="0" />
			</nodes>
			<nodes name="mic2n">
				<coord x="0" y="4" />
			</nodes>
		</nodeList>
	</domain>


	<sequenceStep>
		<!-- Analysis Type -->
		<analysis>
			<transient>
				<numSteps>201</numSteps>
				<deltaT>1e-3</deltaT>
			</transient>
		</analysis>

		<!-- PDE Definition -->
		<pdeList>
			<acoustic formulation="acouPotential">
				<!-- Computation Domain -->
				<regionList>
					<region name="internal" />
					<region name="prop" />
					<region name="pml" dampingId="mypml" />
					<!-- eg.:<region name="internal" /> -->
				</regionList>

				<!-- Non-conforming Interface Definition -->
				<ncInterfaceList>
					<!-- <ncInterface name="..." formulation="..."/> -->
					<!-- eg.: <ncInterface name="NC1" formulation="Nitsche"/> -->
					<ncInterface name="NC1" formulation="Nitsche" />
					<ncInterface name="NC2" formulation="Nitsche" />
				</ncInterfaceList>

				<!-- Damping Model -->
				<dampingList>
					<pml id="mypml">
						<type>inverseDist</type>
						<dampFactor>1</dampFactor>
					</pml>
				</dampingList>

				<!-- Boundary Conditions and Volume Loads -->
				<bcsAndLoads>
					<rhsValues name="internal"> <!-- eg.: <rhsValues name="RegionName"> -->
						<grid>
							<defaultGrid quantity="acouRhsLoad" dependtype="GENERAL" definedOn="node">
								<globalFactor>
									<!-- Scaling Factor from PDE --> <!-- Temporal blending fadeIn(duration, mode, timeval) --> <!-- Spatial blending --> (-1.0 / (rho*c^2)) * fadeIn(tau, 1, t) * ((sqrt(x^2+y^2) lt 1.9)?
									exp(-0.5*(x^2+y^2)/sigma^2) : 0) </globalFactor>
							</defaultGrid>
						</grid>
					</rhsValues>
				</bcsAndLoads>

				<!-- Results Definition -->
				<storeResults>
					<!-- Export point array -->
					<sensorArray fileName="mics/micArrayResults_2m_acouPotentialD1" csv="yes"
						type="acouPotentialD1" delimiter=",">
						<coordinateFile fileName="mics/MicPos.txt" xCoordColumn="1" yCoordColumn="2"
							delimiter="," />
					</sensorArray>
					<sensorArray fileName="mics/micArrayResults_2m_acouIntensity" csv="yes"
						type="acouIntensity" delimiter=",">
						<coordinateFile fileName="mics/MicPos.txt" xCoordColumn="1" yCoordColumn="2"
							delimiter="," />
					</sensorArray>

					<!-- Export element result -->
					<elemResult type="acouIntensity">
						<allRegions />
						<elemList>
							<elems name="mic1e" />
							<elems name="mic2e" />
						</elemList>
					</elemResult>
					<!-- eg.: <elemResult type="acouIntensity"> <allRegions/> </elemResult> -->

					<!-- Export node result -->
					<nodeResult type="acouPotentialD1">
						<allRegions />
						<nodeList>
							<nodes name="mic1n" />
							<nodes name="mic2n" />
						</nodeList>
					</nodeResult>
					<!-- eg.: <nodeResult type="acouPotentialD1"> <allRegions/> </nodeResult> -->
				</storeResults>
			</acoustic>
		</pdeList>
	</sequenceStep>
</cfsSimulation>